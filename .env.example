TZ=Asia/Manila
CLOUDSTREAM_SERVER_NAME=Home server
# Set when an HTTPS reverse proxy terminates TLS:
# CLOUDSTREAM_PUBLIC_ORIGIN=https://cloudstream.example.com

# Optional: one account across several servers through the authentication Worker (auth-worker/README.md).
# Leave unset and the server signs devices in itself.
# CLOUDSTREAM_AUTH_URL=https://cloudstream-auth.YOUR-SUBDOMAIN.workers.dev
# CLOUDSTREAM_AUTH_SECRET=replace-with-the-worker-SERVER_SECRET
